# HieuMini Books — cấu hình Apache

# ---------- Đường dẫn thân thiện ----------
RewriteEngine On
# /sitemap.xml chạy bằng PHP để luôn khớp dữ liệu mới nhất
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# ---------- Chặn truy cập tệp nhạy cảm ----------
<FilesMatch "\.(sql|md|py|log)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
RedirectMatch 404 /tools/

# ---------- Nén ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# ---------- Bộ nhớ đệm trình duyệt ----------
# Tệp tĩnh đã có tham số ?v=<thời gian sửa> nên đặt hạn dài vô tư,
# đổi tệp là URL đổi theo, trình duyệt tự tải bản mới.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ---------- Tiêu đề bảo mật ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------- Trang lỗi ----------
ErrorDocument 404 /404.php
